<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/harmoni_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/harmoni_widget_shape"
    android:clipToOutline="true">

  <ImageView
      android:id="@+id/harmoni_widget_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="centerCrop"
      android:src="@drawable/harmoni_widget_empty"
      android:importantForAccessibility="no" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="16dp"
      android:paddingEnd="12dp"
      android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

      <TextView
          android:id="@+id/harmoni_widget_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:shadowColor="#66000000"
          android:shadowRadius="8"
          android:textColor="#FFFFFF"
          android:textSize="17sp" />

      <TextView
          android:id="@+id/harmoni_widget_artist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:shadowColor="#66000000"
          android:shadowRadius="8"
          android:textColor="#C8FFFFFF"
          android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/harmoni_widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/harmoni_widget_play_bg"
        android:contentDescription="Play"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/harmoni_play" />
  </LinearLayout>
</FrameLayout>
